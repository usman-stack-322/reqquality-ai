DATABASE_URL=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
REQQUALITY_SECRET_KEY=
SESSION_COOKIE_SECURE=true
# Invitation links use the public frontend origin; set your actual URL.
INVITATION_FRONTEND_URL=
# Optional password reset frontend origin; defaults to INVITATION_FRONTEND_URL.
PASSWORD_RESET_FRONTEND_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SSL=false
# FRONTEND_ORIGINS: comma-separated allowed frontend origins (optional locally)
FRONTEND_ORIGINS=https://www.reqqualityai.site,https://reqqualityai.site,https://localhost:5173,https://127.0.0.1:5173

# Cookie-token authentication: configure a persistent random secret (at least 32 bytes).
JWT_SECRET_KEY=
# Set only behind that exact number of trusted proxy hops for BOTH
# X-Forwarded-Proto and X-Forwarded-For. Untrusted clients must not reach the app
# directly with spoofed forwarded headers; the proxy must overwrite them.
TRUST_PROXY_HOPS=0
