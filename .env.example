DATABASE_URL=
GEMINI_API_KEY=
# Verified on the configured account 2026-10-17; verify on other accounts.
GEMINI_MODEL=gemini-3.5-flash-lite
# One provider attempt, hard bounded to 1-25 seconds.
GEMINI_TIMEOUT_MS=20000
REQQUALITY_SECRET_KEY=
SESSION_COOKIE_SECURE=true
# Use Lax with same-origin Vercel /api/:path* rewrite (default), or None only for cross-site HTTPS origins.
COOKIE_SAMESITE=Lax
# Invitation links use the public frontend origin; set your actual URL.
INVITATION_FRONTEND_URL=
# Optional password reset frontend origin; defaults to INVITATION_FRONTEND_URL.
PASSWORD_RESET_FRONTEND_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SSL=false
# FRONTEND_ORIGINS: comma-separated allowed frontend origins (optional locally)
FRONTEND_ORIGINS=https://www.reqqualityai.site,https://reqqualityai.site,https://localhost:5173,https://127.0.0.1:5173

# PostgreSQL pool & TCP keepalive tuning (optional)
DB_POOL_MAX_SIZE=5
DB_POOL_TIMEOUT=15
DB_CONNECT_TIMEOUT=10
DB_KEEPALIVES_IDLE=30
DB_KEEPALIVES_INTERVAL=10
DB_KEEPALIVES_COUNT=5

# Cookie-token authentication: configure a persistent random secret (at least 32 bytes).
JWT_SECRET_KEY=
# Set only behind that exact number of trusted proxy hops for BOTH
# X-Forwarded-Proto and X-Forwarded-For (use 1 on Render). Untrusted clients must
# not reach the app directly with spoofed forwarded headers; the proxy must overwrite them.
TRUST_PROXY_HOPS=0

# Frontend build variable (Vercel optional): leave unset to use frontend/vercel.json
# same-origin /api/:path* rewrite or local Vite dev proxy (127.0.0.1:5000).
# Set only for direct cross-origin API calls (requires COOKIE_SAMESITE=None).
# VITE_API_BASE_URL=https://reqquality-ai-api.onrender.com
